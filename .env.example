# Token del bot (@BotFather).
BOT_TOKEN=

# Texto que, enviado al bot mientras no hay administradores, convierte a quien
# lo envía en el primero. Genera uno con: openssl rand -hex 16
ADMIN_TOKEN=

# Base de datos SQLite. En Docker se ignora (siempre /data/data.db).
DATABASE_URL=file:./data.db

# Puerto e interfaz de la web y el socket (en Docker se ignoran: 0.0.0.0:3000).
# SOCKET_PORT=3000
# SOCKET_HOST=127.0.0.1

# Otros orígenes que pueden abrir el socket, separados por comas (la web se
# sirve desde el mismo origen y no lo necesita).
# SOCKET_CORS_ORIGIN=http://localhost:5173

# Año de la edición que aparece en /start y en la gráfica (por defecto, el actual).
# EDITION_YEAR=2026

# Usuarios que pueden borrar carreras y reiniciar los puntos, y que no se
# pueden quitar como administradores.
# SUPERADMINS=comic_ivans,HipyCas

# trace, debug, info, warn o error.
# LOG_LEVEL=info
TZ=Europe/Madrid

# ─── Solo para docker-compose.yml en el servidor ───────────────────────────
# SANALBERTO_PORT=57630
# SANALBERTO_DATA_DIR=./data
